DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conforma_dev

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conforma_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conforma_test

# Almacenamiento de archivos: local o spaces
FILE_STORAGE_PROVIDER=local
FILE_UPLOAD_DIR=uploads/adjuntos
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# CUIT representada por el certificado de producción y credenciales PEM de ARCA.
ARCA_CUIT=
ARCA_CERT=
ARCA_PRIVATE_KEY=
# Sentry (vacío = desactivado). El mismo DSN para servidor y navegador.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=produccion
PUBLIC_SENTRY_ENVIRONMENT=produccion

# Beszel: clave pública que muestra el panel al agregar el sistema.
BESZEL_KEY=
