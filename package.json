{
	"name": "conforma-system",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run && pnpm test:db && pnpm test:e2e",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrar.mjs",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.mjs",
		"test:db": "tsx --test tests/app.test.ts",
		"test:e2e:install": "playwright install chromium",
		"docker:dev": "docker compose -f docker-compose.dev.yml up -d",
		"docker:up": "docker compose up -d --build",
		"docker:logs": "docker compose logs -f app",
		"docker:down": "docker compose down",
		"docker:reset": "docker compose down -v && docker compose up -d --build",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^4.1.8",
		"daisyui": "^5.7.50",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"sveltekit-superforms": "^2.30.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@arcasdk/core": "2.0.2",
		"@aws-sdk/client-s3": "^3.1165.0",
		"@pdfme/common": "^6.2.8",
		"@pdfme/generator": "^6.2.8",
		"@pdfme/schemas": "^6.2.8",
		"@sentry/sveltekit": "^11.12.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"xlsx": "^0.18.5"
	}
}
